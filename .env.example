# Engineering Tracker environment variables.
# Copy to .env.local for local dev. Never commit real values.
# Generate secrets with: openssl rand -hex 32

# Full URL of the agent's webhook endpoint: {AGENT_BASE_URL}/jira/events from docs/contract.md.
# Use the agent's production domain (preview URLs are behind Vercel login by default).
AGENT_WEBHOOK_URL=https://your-agent.vercel.app/jira/events

# Sent as the X-Webhook-Secret header on every webhook.
# MUST be the same value as TRACKER_WEBHOOK_SECRET in the agent project.
TRACKER_WEBHOOK_SECRET=

# The agent sends this as "Authorization: Bearer <key>" on every write-back API call.
# MUST be the same value as TRACKER_API_KEY in the agent project.
TRACKER_API_KEY=

# Vercel Cron sends this as "Authorization: Bearer <secret>" to /api/cron/auto.
# Only this project needs it. Use at least 16 random characters.
CRON_SECRET=

# Optional. Public base URL of this tracker, used for issue.self in webhooks.
# Defaults to the Vercel production domain. If set, use the same value as the agent's TRACKER_BASE_URL.
TRACKER_BASE_URL=

# Upstash Redis. Added automatically when you connect an Upstash Redis store from the
# Vercel Marketplace (Storage tab). Either pair works; KV_REST_API_* wins if both are set.
# With neither set, the app falls back to an in-memory store (fine locally, not on Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Set to "memory" to force the in-memory store even when Redis vars are present.
TRACKER_STORE=

# Optional. Delays in ms before webhook attempts 2 and 3. Default: 500,2000
WEBHOOK_RETRY_DELAYS_MS=
